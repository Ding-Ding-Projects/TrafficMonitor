{
  "name": "trafficmonitor-documentation-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Offline TrafficMonitor documentation reader",
  "author": "TrafficMonitor contributors",
  "main": "main.cjs",
  "devDependencies": { "electron": "45.0.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "org.dingdingprojects.trafficmonitor.documentation",
    "productName": "TrafficMonitor Documentation",
    "asar": true,
    "directories": { "output": "../artifacts/docs-companion" },
    "files": ["main.cjs", "policy.cjs", "site/**/*", "package.json"],
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }], "signAndEditExecutable": false, "artifactName": "TrafficMonitor-Documentation-${version}-x64.exe" },
    "portable": { "requestExecutionLevel": "user" }
  }
}
